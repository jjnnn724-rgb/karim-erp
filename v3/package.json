{
    "name": "karim-erp-migration",
    "private": true,
    "type": "module",
    "description": "Karim ERP v3 — TypeScript stack (workspace منفصل عن تطبيق npm القديم)",
    "scripts": {
        "typecheck": "pnpm -r typecheck",
