{
    "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 140
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "linter": {
        "rules": {
            "a11y": {
                "noLabelWithoutControl": "warn",
                "noRedundantRoles": "warn",
                "noStaticElementInteractions": "warn",
                "noSvgWithoutTitle": "warn",
                "useAriaPropsSupportedByRole": "warn",
                "useSemanticElements": "warn",
                "useValidAriaRole": "warn"
            },
            "complexity": {
                "noImportantStyles": "warn",
                "noUselessFragments": "warn",
                "useLiteralKeys": "warn",
                "useMathMinMax": "warn",
                "useOptionalChain": "warn"
            },
            "correctness": {
                "noUnsafeOptionalChaining": "warn",
                "useExhaustiveDependencies": "warn"
            },
            "performance": {
                "noAccumulatingSpread": "warn"
            },
            "style": {
                "noDescendingSpecificity": "warn",
                "noNonNullAssertion": "warn",
                "useTemplate": "warn"
            },
            "suspicious": {
                "noArrayIndexKey": "warn",
                "noAssignInExpressions": "warn",
                "noShadowRestrictedNames": "warn"
            }
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "overrides": [
        {
            "includes": ["apps/web/src/print.css"],
            "linter": {
                "rules": {
                    "complexity": {
                        "noImportantStyles": "off"
                    }
                }
            }
        },
        {
            "includes": ["apps/web/src/ui/DataTable.tsx"],
            "linter": {
                "rules": {
                    "a11y": {
                        "noNoninteractiveTabindex": "off"
                    }
                }
            }
        }
    ],
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    }
}
