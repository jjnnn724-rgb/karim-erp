{
    "name": "@karim/shared",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Zod schemas + money/date primitives المشتركة بين الواجهة والخادم",
    "exports": {
        ".": {
            "development": {
                "types": "./src/index.ts",
                "import": "./src/index.ts"
            },
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run --coverage"
    },
    "dependencies": {
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@karim/testing": "workspace:*",
        "@types/node": "^24.0.0",
        "@vitest/coverage-v8": "^3.2.0",
        "typescript": "^5.9.0",
        "vitest": "^3.2.0"
    }
}
