# انسخ هذا الملف إلى .env ثم غيّر كل القيم الفارغة/النموذجية قبل التشغيل.
NODE_ENV=production
HOST=0.0.0.0
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=karim_erp
DB_USER=karim_erp
DB_PASSWORD=

JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
API_KEY=
JWT_EXPIRY=24h

# استبدل example.com بنطاق aaPanel الحقيقي.
ALLOWED_ORIGINS=https://example.com

MEDIA_ROOT=./database/media
BACKUP_PATH=./database/backups
LOG_PATH=./logs

# البريد اختياري؛ اتركه فارغًا حتى يتم ضبط SMTP فعليًا.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

ZATCA_MODE=sandbox
ZATCA_VAT_NUMBER=
ZATCA_CERT_PATH=./certificates/zatca.pem
ZATCA_KEY_PATH=./certificates/zatca-key.pem

DEBUG=false
DEBUG_SQL=false
LOG_LEVEL=info
