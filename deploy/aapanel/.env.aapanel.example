# انسخ هذا الملف إلى .env ثم غيّر كل القيم الفارغة/النموذجية قبل التشغيل.
NODE_ENV=production
HOST=0.0.0.0
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=karim_erp
DB_USER=karim_erp
DB_PASSWORD=

JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
API_KEY=
JWT_EXPIRY=24h

# استبدل example.com بنطاق aaPanel الحقيقي.
ALLOWED_ORIGINS=https://example.com

MEDIA_ROOT=./database/media
BACKUP_PATH=./database/backups
LOG_PATH=./logs

# البريد اختياري؛ اتركه فارغًا حتى يتم ضبط SMTP فعليًا.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

ZATCA_MODE=sandbox
ZATCA_VAT_NUMBER=
ZATCA_CERT_PATH=./certificates/zatca.pem
ZATCA_KEY_PATH=./certificates/zatca-key.pem

DEBUG=false
DEBUG_SQL=false
LOG_LEVEL=info

# كاش Brotli للأصول الساكنة — الضغط مسؤولية Node لأن Nginx هنا reverse proxy.
# BROTLI_CACHE_DIR الافتراضي في production هو ./var/brotli-cache (لا تستخدم /tmp).
BROTLI_CACHE_DIR=./var/brotli-cache
BROTLI_CACHE_MAX_MB=100
BROTLI_CACHE_MAX_AGE_DAYS=7
# ارفعه عند أي تغيير في منطق/جودة الضغط — يُبطل كل النسخ القديمة تلقائيًا.
BROTLI_POLICY_VERSION=v1
# off يوقف مقاييس Brotli بلا أي تغيير في منطق الضغط.
BROTLI_METRICS=on
# WARMUP_ENABLED=false يوقف التسخين الخلفي بلا إعادة تشغيل (القياس يبقى يعمل).
WARMUP_ENABLED=true
