# deploy/saas/.env.staging.example — انسخه إلى .env.staging واملأ القيم من Secrets Manager
DB_NAME=karim_erp_staging
DB_USER=karim_app_staging
DB_PASSWORD=
DB_POOL_MAX=20

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
EMPLOYEE_QR_SECRET=

# ⚠️ بعد تطبيق الترحيلات 155..163 وخط الأساس الرقمي فقط:
SAAS_TENANT_ENABLED=false
SAAS_SIGNUP_ENABLED=false
# مثال: shorfa:11111111-1111-4111-8111-111111111111 (fallback للتطوير فقط)
SAAS_TENANT_MAP=
ALLOWED_ORIGINS=https://staging.karimeg.online
