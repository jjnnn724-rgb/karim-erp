<service>
  <id>KarimERP-Server</id>
  <name>Karim ERP Server</name>
  <description>Karim ERP API + realtime server (starts with Windows)</description>
  <!-- FIX 2026-10-03 (Enterprise): كان يشير إلى node محمّل غير موجود على هذا
       الجهاز (%BASE%\..\node\node.exe) — المسار الآن node النظامي المثبت.
       للتوزيع المحمول أعده إلى %BASE%\..\node\node.exe مع نسخ node محمول.
       UPDATE 2026-10-08: node المحمول في C:\nodejs (مثبت يدويًا بعد الفقد). -->
  <executable>C:\nodejs\node.exe</executable>
  <arguments>%BASE%\..\backend\server.js --service</arguments>
  <workingdirectory>%BASE%\..</workingdirectory>
  <logpath>%BASE%\..\logs</logpath>
  <log mode="roll-by-size"><sizeThreshold>10485760</sizeThreshold><keepFiles>10</keepFiles></log>
  <!-- Keep retrying after repeated crashes; progressively back off instead of
       leaving the ERP stopped after a fixed number of failures. -->
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="restart" delay="60 sec" />
  <startmode>Automatic</startmode>
  <stoptimeout>30 sec</stoptimeout>
  <hidewindow>true</hidewindow>
  <env name="KARIM_SERVICE" value="1" />
  <!-- TEST MODE 2026-10-03 removed: حدود الاختبار المؤقتة أُزيلت بعد اكتمال القياس (production limits restored) -->
</service>
