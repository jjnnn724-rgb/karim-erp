<service>
  <id>KarimERP-Server</id>
  <name>Karim ERP Server</name>
  <description>Karim ERP API + realtime server (starts with Windows)</description>
  <!-- FIX 2026-10-03 (Enterprise): كان يشير إلى node محمّل غير موجود على هذا
       الجهاز (%BASE%\..\node\node.exe) — المسار الآن node النظامي المثبت.
       للتوزيع المحمول أعده إلى %BASE%\..\node\node.exe مع نسخ node محمول. -->
  <executable>C:\Program Files\nodejs\node.exe</executable>
  <arguments>%BASE%\..\backend\server.js --service</arguments>
  <workingdirectory>%BASE%\..</workingdirectory>
  <logpath>%BASE%\..\logs</logpath>
  <log mode="roll-by-size"><sizeThreshold>10485760</sizeThreshold><keepFiles>10</keepFiles></log>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="60 sec" />
  <onfailure action="none" />
  <startmode>Automatic</startmode>
  <stoptimeout>30 sec</stoptimeout>
  <hidewindow>true</hidewindow>
  <env name="KARIM_SERVICE" value="1" />
</service>
