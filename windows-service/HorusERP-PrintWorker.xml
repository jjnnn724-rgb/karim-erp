<service>
  <id>HorusERP-PrintWorker</id>
  <name>Horus ERP Print Worker</name>
  <description>Horus ERP thermal print queue worker (starts with Windows)</description>
  <executable>C:\Users\karim\AppData\Local\hermes\node\node.exe</executable>
  <arguments>backend\cashier-module\print-worker.js</arguments>
  <workingdirectory>C:\Users\karim\Desktop\karimabdelhamedeldsouky\karimabdelhamed12\horus-erp</workingdirectory>
  <logpath>C:\Users\karim\Desktop\karimabdelhamedeldsouky\karimabdelhamed12\horus-erp\logs</logpath>
