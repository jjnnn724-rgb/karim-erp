<service>
  <id>KarimERP-PrintWorker</id>
  <name>Karim ERP Print Worker</name>
  <description>Karim ERP thermal print queue worker (starts with Windows)</description>
  <executable>%BASE%\..\node\node.exe</executable>
  <arguments>%BASE%\..\backend\cashier-module\print-worker.js --service</arguments>
  <workingdirectory>%BASE%\..</workingdirectory>
  <logpath>%BASE%\..\logs</logpath>
  <log mode="roll-by-size"><sizeThreshold>10485760</sizeThreshold><keepFiles>10</keepFiles></log>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="60 sec" />
  <onfailure action="none" />
  <startmode>Automatic</startmode>
  <stoptimeout>30 sec</stoptimeout>
  <hidewindow>true</hidewindow>
  <env name="KARIM_SERVICE" value="1" />
</service>
