# Karim ERP — environment template v5.0
# الطريقة الذكية (موصى بها): دبل كليك على SETUP-SMART.bat — يكتشف
# PostgreSQL المثبتة والمنفذ العامل ويصلح كل شيء تلقائياً.
# الطريقة اليدوية: انسخ هذا الملف إلى .env واملأ القيم الحقيقية.
NODE_ENV=production
HOST=0.0.0.0
PORT=5001
ALLOWED_ORIGINS=https://localhost:5001,https://127.0.0.1:5001,https://SERVER-LAN-IP:5001
SSL_KEY=C:/HorusData/certs/karim-erp-lan-key.pem
SSL_CERT=C:/HorusData/certs/karim-erp-lan.pem

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=karim_erp
DB_USER=postgres
DB_PASSWORD=
# ─── Database mode: system only (installed PostgreSQL).
#     DB_PASSWORD must equal the real postgres superuser password you set
#     during PostgreSQL installation. NEVER invent a random one.
#     DB_PORT is auto-detected (5432..5444) by scripts/smart-install.js.
DB_MODE=system

# Generate strong random values for every deployment.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
EMPLOYEE_QR_SECRET=

# Optional local-worker setting.
SKIP_BULLMQ=true

# ─── رابط التحقق العام لبطاقات الموظف (QR) ─────────────────────────────
# يجب أن يكون الدومين العام الذي يصل له الهاتف (بدون / في النهاية).
CARD_VERIFY_BASE=https://karimeg.online

# ─── Attendance PUSH channel (Face/Hikvision → queue → unified engine) ──────
# يعمل بدون Redis (SQL mirror) — فعّل Redis فقط لامتصاص السبايك:
# REDIS_URL=redis://localhost:6379
# ATTENDANCE_PUSH_DEDUP_SEC=60
# ATTENDANCE_PUSH_EMBEDDED=true
# ATTENDANCE_PUSH_POLL_MS=10000

# ─── Optional integrations (all have safe fallbacks) ─────────────────────
# Reverse proxy / rate limiting:
# TRUST_PROXY=true
# Prometheus metrics protection:
# METRICS_API_KEY=
# ─── Brotli للأصول الساكنة (Node يضغط؛ Nginx في aaPanel وكيل عكسي فقط) ───
# BROTLI_CACHE_DIR=./var/brotli-cache   # يسبق الكل؛ في production الافتراضي ./var/brotli-cache
# BROTLI_CACHE_MAX_MB=100               # سقف حجم الكاش على القرص
# BROTLI_CACHE_MAX_AGE_DAYS=7           # عمر أقصى للنسخة قبل الحذف
# BROTLI_CACHE_SWEEP_MS=21600000        # دورة التنظيف الدورية (6 ساعات)
# BROTLI_POLICY_VERSION=v1              # جزء من مفتاح الكاش — ارفعه عند تغيير منطق/جودة الضغط
# BROTLI_METRICS=on                     # off يوقف القياس بلا أي تغيير في منطق الضغط
# WARMUP_ENABLED=true                   # false يوقف التسخين الخلفي بلا إعادة تشغيل
# Real-time multi-device layer (TASK 4-9; ALL default OFF = legacy behavior):
# RT_REQUIRE_AUTH=false            # true → sensitive socket broadcasts to verified sockets only
# RT_FAIL_CLOSED=false             # true → outbox insert failure aborts the business txn (verify first!)
# RT_EVT_KITCHEN=false RT_EVT_DISPATCH=false RT_EVT_PURCHASE=false
# RT_EVT_INVENTORY=false RT_EVT_HR=false RT_EVT_EXPENSE=false RT_EVT_PAYMENT=false
# RT_OUTBOX_LEASE_SECONDS=30 RT_OUTBOX_BATCH=50 RT_OUTBOX_INTERVAL_MS=500 RT_OUTBOX_MAX_ATTEMPTS=20
# RT_MAX_GAP_EVENTS=5000 RT_MAX_GAP_HOURS=24
# Logging: LOG_LEVEL=info | debug, LOG_PRETTY=true for local pretty output
# LOG_LEVEL=info
# OpenTelemetry (traces/metrics تلقائي عبر backend/otel.js — معطّل افتراضيًا):
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=karim-erp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   (Jaeger/Tempo/Grafana Alloy)
# اللغة/العملة/الضريبة الافتراضية — تقرأها الواجهات عبر GET /api/i18n/config:
# DEFAULT_LANGUAGE=ar            (ar | en)
# CURRENCY_DEFAULT=SAR           (رمز ISO من 3 حروف)
# DEFAULT_TAX_RATE=0.15          (نسبة عشرية، 0.15 = 15%)
# Attendance late-flag hour (Asia/Riyadh clock):
# WORK_START_HOUR=9
# keep all punch dates on the wall calendar date (recommended if the business does not use night-shift carryover)
# ATTENDANCE_SHIFT_DAY_MODE=off
# If using night-shift carryover, set NIGHT_CUTOFF_HOUR=5 to move punches before 05:00 to the previous day.
# NIGHT_CUTOFF_HOUR=5
# ZATCA e-invoicing (developer portal by default):
# ZATCA_ENABLED=false        # master kill-switch: معطل افتراضيًا حتى الاعتماد الفعلي من ZATCA
# ZATCA_API_BASE=https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal
# ZATCA_ECDSA_PRIVATE_KEY_B64=
# ZATCA_MAX_ATTEMPTS=10
# ─── تفويض الخصم وتخفيض السعر في الكاشير (fail-closed) ──────────────────
# الافتراضي 0% = مغلق: لا خصم ولا تخفيض سعر إلا من دور معتمد.
# غيّر القيم حسب سياسة المالك (لا تُترك على 0 إن كان هناك خصم جارٍ).
# SALE_DISCOUNT_MAX_PERCENT=0          # أقصى خصم (نسبة من إجمالي السطر) لغير المعتمد
# SALE_PRICE_OVERRIDE_MAX_PERCENT=0    # أقصى تخفيض سعر (نسبة من سعر القائمة) لغير المعتمد
# SALE_DISCOUNT_APPROVER_ROLES=manager,admin   # الأدوار التي تتجاوز الحد (تُسجَّل في pos_audit_logs)
# Redis-backed ZATCA/print queues (SKIP_BULLMQ=true disables Redis entirely):
# REDIS_URL=redis://localhost:6379
# Daily email report:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# REPORT_EMAIL_TO=
# REPORT_EMAIL_FROM=
# REPORT_TIMEZONE=Asia/Riyadh
# REPORT_EMAIL_TIME=23:00
# BACKUPS_DIR=
# KARIM_BACKUP_RETENTION=14
# مجلد حزم تحديث العميل عبر الشبكة (يُقدَّم من /updates) — افتراضيًا backend/../updates:
# KARIM_UPDATES_DIR=
# Daily WhatsApp manager brief:
# WHATSAPP_ENABLED=true
# WHATSAPP_DAILY_REPORT=true
# WHATSAPP_DAILY_REPORT_TIME=23:30
# WHATSAPP_MANAGER_JIDS=9665XXXXXXXX,9665YYYYYYYY

# ─── ZKTeco biometric sync (inside the ERP process) ─────────────────────
# محرك البصمة يعمل تلقائيًا مع الخادم — لا إعداد إلزامي هنا.
# فترة إعادة معالجة البصمات المتأخرة بالساعات (الافتراضي 72):
# ZK_REPROCESS_HOURS=72

# ─── Yarasoft POS invoice import (network share = integration boundary) ──
# لا يبدأ أي استيراد قبل التأكد من صيغة الملفات بأداة التشخيص:
#   node tools/yarasoft-inspect.js --share "\\server\Yarasoft\pos"
# YARASOFT_ENABLED=false
# YARASOFT_DRY_RUN=true
# YARASOFT_SHARE=\\server\Yarasoft\pos
# YARASOFT_INVOICES_DIR=Invoices
# YARASOFT_PROCESSING_DIR=Invoices_Processing
# YARASOFT_ARCHIVE_DIR=Invoices_Archive
# YARASOFT_FAILED_DIR=Invoices_Failed
# FILE_STABILITY_DELAY=2000
# FILE_STABILITY_CHECKS=3
# NETWORK_RETRY_INTERVAL=30
# YARASOFT_SCAN_INTERVAL=10
# YARASOFT_MAX_RETRIES=5
# YARASOFT_MAX_FILE_MB=10
# YARASOFT_FILE_PATTERNS=.txt,.csv
# YARASOFT_DEPT_CODE=yarasoft_pos
# YARASOFT_LOCATION_CODE=MAIN-WAREHOUSE
# YARASOFT_LOCATION_ID=
# YARASOFT_PROFILE=./backend/yarasoft/format-profile.json
# YARASOFT_LOG_RETENTION_DAYS=180

# ─── WhatsApp engine (Baileys, داخل عملية السيرفر — معطّل افتراضيًا) ──────
# WHATSAPP_ENABLED=false
# WHATSAPP_DAILY_REPORT=true
# WHATSAPP_DAILY_REPORT_TIME=23:30
# WHATSAPP_SESSION_DIR=C:/KarimData/whatsapp-sessions
# WHATSAPP_LOG_DIR=C:/KarimData/whatsapp-logs
# WHATSAPP_LOG_LEVEL=info
# WHATSAPP_RECONNECT_BASE_DELAY=2000
# WHATSAPP_RECONNECT_MAX_DELAY=60000
# WHATSAPP_MAX_RETRIES=5
# WHATSAPP_SEND_TIMEOUT=30000
# WHATSAPP_WORKER_INTERVAL=5000
# WHATSAPP_MAX_OUTBOUND_PER_MIN=20
# WHATSAPP_HISTORY_DAYS=90
# WHATSAPP_MEDIA_DIR=C:/KarimData/whatsapp-media
# WHATSAPP_BACKUP_DIR=C:/KarimData/whatsapp-backups
# MEDIA_ENABLED=true
# MEDIA_MAX_SIZE_MB=16
# ─── درع الحظر (أي تجاوز = رفض 429 قبل الوصول لواتساب) ───
# WA_SEND_MIN_GAP_MS=3000          # فجوة دنيا بين الرسائل (مللي ثانية)
# WA_SEND_JITTER_MS=2500           # عشوائية بشرية فوق الفجوة
# WA_SEND_TYPING_MS=1500           # مدة مؤشر "يكتب..." قبل الإرسال
# WA_WARMUP_SCHEDULE=20,40,80,160,320,640,1000   # سقف يومي حسب عمر الجلسة
# WA_COLD_CAP_SCHEDULE=5,10,20,40,60,80,100      # سقف التواصل البارد اليومي
# WA_BULK_DISTINCT_JIDS=8          # نفس النص لأكثر من N جهات = تجميد جماعي
# WA_BULK_WINDOW_MIN=10
# WA_SEND_BREAKER_FAILS=5          # إخفاقات متتالية توقف الإرسال مؤقتًا
# WA_SEND_BREAKER_COOLDOWN_MS=900000
# JWT_REFRESH_DAYS=365
# ERP_API_TIMEOUT=8000
# WHATSAPP_MANAGER_JIDS=9665XXXXXXXX (أرقام المديرين المصرح لهم بأمر «تقرير» واتساب، بفواصل)

# ─── AI Chatbot (100% FREE & Open Source — لا تحتاج أي اشتراك) ──────────────
# لتفعيل المساعد الذكي على واتساب: AI_ENABLED=true
# المزود المجاني الافتراضي: Ollama (محلي، مفتوح المصدر، بدون إنترنت)
# التثبيت: حمّل Ollama من https://ollama.com ثم شغّل: ollama pull llama3.1:8b
# AI_ENABLED=true
# AI_PROVIDER=ollama              # ollama | lmstudio | textgen (كلها مجانية محلية)
# AI_MODEL=llama3.1:8b            # أي موديل Ollama: qwen2.5:7b, mistral:7b, phi3:14b
# AI_TEMPERATURE=0.3              # 0=محدد، 1=إبداعي
# AI_MAX_TOKENS=200               # حد طول الرد
# AI_TIMEOUT_MS=15000             # مهلة الاستجابة
# AI_RATE_LIMIT=30                # حد الرسائل لكل مستخدم/ساعة
# OLLAMA_URL=http://127.0.0.1:11434   # رابط Ollama المحلي
# LMSTUDIO_URL=http://127.0.0.1:1234  # رابط LM Studio المحلي
# بدون LLM محلي: المحرك يستخدم NLU (فهم لغة طبيعي) للردود الذكية — يعمل بدون أي شيء!

# ─── ميزات احترافية عالمية (مجانية) ──────────────────────────────────────────
# INTERACTIVE_ENABLED=true         # أزرار وقوائم تفاعلية في واتساب
# SCHEDULING_ENABLED=true          # جدولة الرسائل (مرة واحدة/يومي/أسبوعي/شهري)
# SCHEDULER_INTERVAL=30000         # فحص الرسائل المجدولة كل 30 ثانية

# ─── مفاتيح أُضيفت تلقائيًا بواسطة مدقق النظام ───
SERVER_IP=
TRUST_PROXY=
YARASOFT_ENABLED=
YARASOFT_DRY_RUN=
YARASOFT_SHARE=
# مفتاح تشفير خزنة كلمات المرور (vault) — اتركه فارغًا لتعطيل التشفير:
VAULT_KEY=
# ─── أرشفة النسخة الاحتياطية خارج الموقع (مشفّرة) ────────────────────────
# بدون هذه الإعدادات لا تُنشأ أي نسخة خارج الموقع (السكربت يرفض النص الصريح).
# الطريقة الموصى بها: عبارة مرور تحفظها في مدير كلمات المرور (لا ملف يُنقل،
# ولا مفتاح يضيع). استخدم gpg بدلها إن كنت تُدير مفتاحًا مؤسسيًا.
# KARIM_BACKUP_PASSPHRASE=
# بصمة المفتاح العام للمؤسسة (40 أو 64 محرفًا hex) — بديل لطريقة عبارة المرور:
# KARIM_BACKUP_GPG_RECIPIENT=
# مسار تنفيذ gpg إن لم يكن في PATH:
# KARIM_GPG_PATH=
# وجهة المرآة (أقراص أخرى على نفس الجهاز):
# KARIM_MIRROR_D=D:/KarimBackups
# KARIM_MIRROR_E=E:/KarimBackups
YARASOFT_ORACLE_ENABLED=
YARASOFT_ORACLE_HOST=
YARASOFT_ORACLE_PORT=
YARASOFT_ORACLE_SERVICE=
YARASOFT_ORACLE_USER=
YARASOFT_ORACLE_PASSWORD=
# مجموعات احتياطية للتدوير التلقائي عند تغيير كلمة المرور (ORA-01017) — تُجرَّب بالترتيب
# YARASOFT_ORACLE_USER_2=
# YARASOFT_ORACLE_PASSWORD_2=
# YARASOFT_ORACLE_USER_3=
# YARASOFT_ORACLE_PASSWORD_3=
YARASOFT_ORACLE_IC_PATH=
YARASOFT_ORACLE_POLL_MIN=
YARASOFT_ORACLE_STAGING=
YARASOFT_ORACLE_INVOICE_SQL=
YARASOFT_ORACLE_LIVE=
ATTENDANCE_AUTO_COMPLETE=
# false = إيقاف محرك التأخير (بصمة خام فقط) — true = السلوك الأصلي
ATTENDANCE_DELAY_ENGINE=
WHATSAPP_ENABLED=
WHATSAPP_SESSION_DIR=
WHATSAPP_LOG_LEVEL=
WHATSAPP_RECONNECT_BASE_DELAY=
WHATSAPP_RECONNECT_MAX_DELAY=
WHATSAPP_MAX_RETRIES=
WHATSAPP_SEND_TIMEOUT=
WHATSAPP_WORKER_INTERVAL=
WHATSAPP_MAX_OUTBOUND_PER_MIN=
ERP_API_TIMEOUT=
WHATSAPP_MANAGER_JIDS=
YARASOFT_CLASSIFY_FROM=
CARD_VERIFY_BASE=

# ─── مفاتيح موثّقة (كانت غائبة — أضافها مدقق النظام 2026-10-21) ──────
# مفتاح التطبيق: يمرره المتصفح في ترويسة x-api-key لواجهات /api/*
# (بلا استثناء: يعمل على شبكة موثوقة فقط؛ ويلزم تدويره عند أي شك)
API_KEY=
# مقاس مجموعة اتصالات القاعدة (بلا قيمة = الافتراضي):
DB_POOL_MAX=
# بصمة الذاكرة (الحضور) — off/on:
ATTENDANCE_SHIFT_DAY_MODE=
# جدولة التسخين لواتساب (HH:MM):
WA_WARMUP_SCHEDULE=
# مصادقة إلزامية لبث الأحداث في الوقت الحقيقي (true = لا بث بلا توكن):
RT_REQUIRE_AUTH=
# ذكاء اصطناعي اختياري (Gemini) — اتركه فارغًا لتعطيله:
GEMINI_API_KEY=
GEMINI_MODEL=
# كلمة مرور admin الثابتة (تُستخدم فقط في ترقية كلمات المرور النصية إلى
# bcrypt) — لا تضعها في مستودع منشور؛ استخدمها في .env على الجهاز فقط:
KARIM_FIXED_ADMIN_PASSWORD=
