<?xml version="1.0" encoding="utf-8"?>
<!-- Trust system CAs + user-installed CAs (mkcert root installed on the device).
     Required because the LAN server uses a private mkcert certificate. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
